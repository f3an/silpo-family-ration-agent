# Which model backend runs the agent loop (src/llm/, src/anthropic/anthropic.service.ts):
#   anthropic (default) — the real Claude API, needs ANTHROPIC_API_KEY below.
#   openai — the real hosted OpenAI API, needs OPENAI_API_KEY below instead.
#   local — a server on your own machine/LAN — needs LOCAL_LLM_BASE_URL +
#     LOCAL_LLM_MODEL below instead. For when Anthropic credits run out but
#     you still want to demo end-to-end against a locally-hosted model.
LLM_PROVIDER=anthropic

# Claude API key used to run the agent loop (https://console.anthropic.com/).
# Required when LLM_PROVIDER=anthropic — the app fails fast on startup without it.
ANTHROPIC_API_KEY=

# Only used when LLM_PROVIDER=anthropic. Which Claude model to call — default
# is Sonnet 5. Claude Haiku 4.5 (claude-haiku-4-5-20251001) is half the price
# on both input and output while keeping Sonnet's same reliable tool-calling
# (same API, same abstraction — no code change, no dialect-mismatch risk the
# local providers below have) — worth trying first if credits are tight.
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI API key (https://platform.openai.com/api-keys). Required when
# LLM_PROVIDER=openai — the app fails fast on startup without it.
OPENAI_API_KEY=

# Only used when LLM_PROVIDER=openai. Default gpt-5.6-luna — OpenAI's
# cheap/fast tier, ~4-5x cheaper than Claude Haiku 4.5 per the pricing pages,
# but not yet validated against this app's actual product-matching accuracy
# bar — worth an empirical test before trusting it over Sonnet/Haiku.
OPENAI_MODEL=gpt-5.6-luna

# Only used when LLM_PROVIDER=openai. GPT-5.6+ rejects a Chat Completions
# request that includes tools unless this is explicitly 'none' — this app's
# full conversational tool loop (run.ts) always sends tools, so 'none' is
# the only value that reliably avoids a 400 there. Leave as-is unless you
# have a specific reason to trade that reliability for more "thinking".
OPENAI_REASONING_EFFORT=none

# Only used when LLM_PROVIDER=local. Point this at your local server's base
# URL — e.g. LM Studio's local server default is http://localhost:1234/v1
# (or http://<your-lan-ip>:1234/v1 if the API runs on a different machine
# than the one hosting the model). No trailing slash.
LOCAL_LLM_BASE_URL=
# The exact model id loaded in your local server (e.g. LM Studio shows this
# in its own UI — must support tool/function calling for the agent to work).
LOCAL_LLM_MODEL=
# Which dialect LOCAL_LLM_BASE_URL speaks:
#   anthropic (default) — confirmed working against LM Studio's local
#     server, which also exposes a native Anthropic-compatible /v1/messages
#     (real tool_use, no translation, no dialect-mismatch bugs). Sent
#     non-streaming — LM Studio's tool-call parser turned out to be
#     unreliable under streaming (confirmed live: it can leak a raw
#     {"name":...,"arguments":{...}} as plain text instead of a real
#     tool_use block, especially after the model writes explanatory prose
#     first — see api/README.md for the full story).
#   openai — the OpenAI-compatible /chat/completions dialect (Ollama, vLLM,
#     llama.cpp server, or an LM Studio version without the endpoint above).
LOCAL_LLM_API=anthropic
# Request timeout in ms for the local server, either dialect (default 300000 = 5min).
LOCAL_LLM_TIMEOUT_MS=

# Optional, LOCAL_LLM_API=openai only (the only dialect confirmed to route
# by the request's model field — the anthropic dialect always serves
# whatever's loaded regardless). Runs dish/plan drafting (deciding WHAT to
# cook) on a second, separately-loaded local model, while LOCAL_LLM_MODEL
# keeps handling routing + product-picking (choosing WHICH real Silpo
# product matches an ingredient). Confirmed live: qwen2.5-7b-instruct (fast,
# accurate at picking) hallucinates non-word ingredient names when asked to
# draft a dish from scratch, even at temperature 0; meta-llama-3.1-8b-instruct
# produced real Ukrainian ingredient words for the same prompt — slower, but
# not hallucinating. Leave unset to draft with LOCAL_LLM_MODEL too.
LOCAL_DRAFT_LLM_MODEL=

# Official Silpo MCP server (see https://ai-factory.silpo.ua/docs/mcp)
SILPO_MCP_URL=https://mcp.silpo.ua/mcp

# Local port used to catch the OAuth redirect during first-time login
# (only the legacy shared CLI/chat flow — see src/mcp/oauthProvider.ts)
OAUTH_CALLBACK_PORT=8765

# Where /auth/silpo/authorize and /auth/silpo/callback send the browser back
# to once the guest has logged into their own Silpo account (client/).
CLIENT_URL=http://localhost:5173

# Postgres for silpo_sessions (OAuth tokens per guest) and user_preferences
# (saved ration preferences per Silpo account) — see src/db/. Matches
# docker-compose.yml at the repo root: `docker compose up -d postgres`.
DATABASE_URL=postgresql://silpo_agent:silpo_agent@localhost:5432/silpo_agent

# Redis cache for /agent/plan responses (see src/cache/, src/agent/planCache.ts)
# — dedupes repeat requests so they skip the Claude tool-use loop entirely.
# Optional: a Redis outage degrades to "always a cache miss," never an error.
# `docker compose up -d redis`.
REDIS_URL=redis://localhost:6379
