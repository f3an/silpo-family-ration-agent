# Claude API key used to run the agent loop (https://console.anthropic.com/).
# Optional for local dev: leave empty to fall back to the local Claude
# credential chain instead (e.g. a subscription profile from `ant auth
# login`) — no API key needed to just run the app locally.
ANTHROPIC_API_KEY=

# Official Silpo MCP server (see https://ai-factory.silpo.ua/docs/mcp)
SILPO_MCP_URL=https://mcp.silpo.ua/mcp

# Local port used to catch the OAuth redirect during first-time login
OAUTH_CALLBACK_PORT=8765
